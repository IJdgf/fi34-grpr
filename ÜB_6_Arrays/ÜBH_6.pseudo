# Übung 5
int [] karr = {-1, 2, 3, -4, -5}
Zähle i von 0 bis karr.länge-1:
    Wenn ((i+1) % 2 == 0):
        karr[i] = -1 * karr[i]
    Ende
Ende

# Übung 6
int[] arr = {23, 5, 46, 52, 18, 43}
int maxInd = 0, minInd = 0
Für(int i = 1; i < arr.länge; i++):
    Wenn (arr[i] > arr[maxInd])
        maxInd = i
    Ende
    Wenn ((i+1) % 2 == 0 Und arr[i] < arr[minInd]):
        minInd = i
    Ende
Ende
Ausgeben arr[maxInd], maxInd, arr[minInd], minInd

