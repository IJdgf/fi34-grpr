# 9
int laenge
Ausgeben "Bitte die Länge eingeben"
Eingeben laenge
Solange (laenge <= 0):
    Ausgeben "Die Länge muss positiv sein. Bitte wiederholen: "
    Eingeben laenge
Ende

int[] arr = Array mit laenge Feldern
Für (int i = 0; i < laenge; i++):
    Ausgeben "Bitte 1 oder 0 eingeben"
    Eingeben arr[i]
    Solange (arr[i] != 1 Und arr[i] != 0):
        Ausgeben "Nur 1 oder 0 erlaubt"
        Eingeben arr[i]
    Ende
Ende
int summe = 0
Für (int i = 0; i < laenge; i++):
    summe = summe + arr[laenge - 1 - i]*2**i
Ende

Ausgeben summe






