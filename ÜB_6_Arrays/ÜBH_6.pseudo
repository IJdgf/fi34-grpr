# Übung 3
String[] harry = Array mit 5 Feldern
Für (int i = 0; i < harry.länge; i++):   # Zähle i von 0 bis barry.länge
    Ausgeben "Bitte das " + (i+1) + ". Element über Tastatur eingeben:"
    Eingeben harry[i]
Ende

Für (int i = harry.länge-1; i >= 0; i--):
    Ausgeben harry[i]
Ende

# Übung 4

int[] harry = Array mit 5 Feldern
Für (int i = 0; i < harry.länge; i++):
    Ausgeben "Bitte das " + (i+1) + ". Element über Tastatur eingeben:"
    Eingeben harry[i]
Ende

int c
Für (int i = 0; i < harry.länge / 2; i++):
    c = harry[i]
    harry[i] = harry[harry.länge - 1 - i]
    harry[harry.länge - 1 - i] = c
Ende

